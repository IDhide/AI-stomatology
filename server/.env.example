# ════════════════════════════════════════════════════════════════════
#  Серверный backend — переменные окружения
#  Скопируйте в server/.env и заполните. Без ключей всё работает на mock.
# ════════════════════════════════════════════════════════════════════

# ── Выбор провайдеров ───────────────────────────────────────────────
LLM_PROVIDER=grok            # grok | mock
STT_PROVIDER=elevenlabs      # elevenlabs | mock
TTS_PROVIDER=elevenlabs      # elevenlabs | mock

# ── Grok (xAI) ──────────────────────────────────────────────────────
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
# ВАЖНО: для голосового киоска нужна быстрая модель БЕЗ reasoning.
# grok-4.3/4.5 «думают» перед ответом 3-6с — для голоса тяжеловато.
# Актуальный список моделей: curl https://api.x.ai/v1/models с вашим ключом.
# Варианты: grok-4.20-0309-non-reasoning (рекомендую, TTFT ~0.7с)
GROK_MODEL=grok-4.20-0309-non-reasoning
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=400

# ── ElevenLabs (STT Scribe + TTS Flash) ─────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # id женского русского голоса
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# ── Telegram (сводка заявок на запись администратору) ────────────────
# Токен бота: @BotFather → /newbot.
# Chat ID: написать боту что угодно, потом открыть в браузере
# https://api.telegram.org/bot<TOKEN>/getUpdates — взять число из "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_TIME=21:00
BOOKINGS_DIR=data/bookings

# ── Узнавание пациента по голосу (экспериментально, см. план) ────────
# Требует `pip install resemblyzer` (тянет CPU-сборку PyTorch, ~200-300 МБ).
# По умолчанию выключено. Даже включив, оставляйте SHADOW_MODE=true, пока
# не наберётся статистика реальных совпадений для калибровки порога.
#
# VOICE_MATCH_THRESHOLD — косинусное расстояние: 0 = идентично, 2 = противоположно.
# Порог 0.15 соответствует 85% сходству голосов (similarity = 1 - distance).
# При сходстве >= 75% Оливия уверенно встречает пациента по имени.
# При сходстве 65–75% — только мягко переспрашивает, не утверждая личность.
VOICE_ID_ENABLED=false
VOICE_ID_SHADOW_MODE=true
VOICE_MATCH_THRESHOLD=0.17
VOICE_MATCH_WEAK_THRESHOLD=0.35
VOICE_MIN_SAMPLE_SECONDS=12
VOICE_MEMORY_PATH=data/voice_memory.sqlite3

# ── DIKIDI (только чтение записей; без ключей — демо-данные) ────────
DIKIDI_API_KEY=
DIKIDI_COMPANY_ID=
DIKIDI_BASE_URL=https://api.dikidi.net
# true — тестовые демо-записи, когда DIKIDI не подключён. В проде НЕ включать!
DIKIDI_DEMO=false

# ── Supabase (память + лица) ────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Логи разговоров ─────────────────────────────────────────────────
# Папка создаётся при первом запуске; в ней по дням лежат .jsonl (для
# скриптов) и .txt (читаемая расшифровка) каждого диалога
CONVERSATIONS_DIR=data/conversations

# ── Логика диалога ──────────────────────────────────────────────────
SILENCE_END_SECONDS=10
FACE_MATCH_THRESHOLD=0.42
REGREET_MINUTES=45
PROMPTS_PATH=config/prompts.yaml
